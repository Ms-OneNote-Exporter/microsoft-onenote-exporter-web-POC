# Copy to .env and fill in. .env is gitignored; never commit RUNNER_TOKEN.
#
# Shared secret between the app and the runner. The app presents it as
# `x-runner-token` on every runner request. Generate one with:
#     openssl rand -hex 32
RUNNER_TOKEN=

# How long a session (and its auth.json + exported notebooks) survives.
SESSION_TTL_HOURS=12

# Refuse to start an export when the host has less free space than this.
MIN_FREE_DISK_MB=2048

# Hard limits on a single child process. These are enforced by the runner, which
# is where the child lives: a login that hangs on an unanswered MFA prompt, or an
# export that wedges, is killed rather than waited on forever.
LOGIN_TIMEOUT_MS=900000
EXPORT_TIMEOUT_MS=5400000

# app log level: debug | info | warn | error
LOG_LEVEL=info

# Local development only. 1 makes the runner spawn fake CLIs that emit the real
# packages' log lines, so the whole pipeline can be exercised with no Microsoft
# account and no Chromium download. Leave at 0 for anything real.
MSOUT_FAKE=0

# Set to 1 ONLY on a host that cannot enable unprivileged user namespaces.
# This disables Chromium's renderer sandbox - the reason a browser exists in the
# runner at all. PLAN-v3(POC).md §18.
CHROMIUM_NO_SANDBOX=0