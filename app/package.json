{
  "name": "@msout-poc/app",
  "version": "0.0.0",
  "private": true,
  "description": "Public-facing app: session state, job queue, SSE and the React UI",
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "vite build",
    "build": "npm run build:web && npm run build:server",
    "start": "node dist/server/index.js",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit"
  },
  "dependencies": {
    "@fastify/static": "8.1.1",
    "@msout-poc/shared": "0.0.0",
    "fastify": "5.12.5",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "22.13.5",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "tsx": "4.19.3",
    "typescript": "5.7.3",
    "vite": "6.0.11",
    "vitest": "5.0.3"
  }
}
